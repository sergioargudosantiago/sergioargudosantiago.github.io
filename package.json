{
  "name": "sergioargudosantiago-web",
  "version": "1.0.0",
  "private": true,
  "description": "Portal personal y visualizador de comercio exterior",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./css/tailwind.css --watch",
    "temas:extraer": "bash scripts/extraer-temas.sh",
    "temas:auditar": "node scripts/auditar-temas.js",
    "temas:revisar": "npm run temas:extraer && npm run temas:auditar",
    "articulos": "node scripts/build-articulos.js",
    "parciales": "node scripts/sincronizar-parciales.js && node scripts/build-articulos.js",
    "fichas": "node scripts/generar-fichas.js && node scripts/generar-fichas-balanza.js",
    "fichas:pdf": "node scripts/fichas-pdf.js",
    "balanza": "node scripts/update_balanza_data.js && npm run fichas",
    "balanza:comprobar": "node scripts/update_balanza_data.js --simular",
    "test": "node --test \"scripts/lib/*.test.js\""
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
