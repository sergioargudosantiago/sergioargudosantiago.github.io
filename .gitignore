# Ojo: no versionar algo no basta para que no se publique, y versionarlo no
# obliga a publicarlo. Lo que el sitio NO sirve se controla en _config.yml.

# ===== Dependencias y sistema =====
/node_modules
.DS_Store
Thumbs.db
*.log
.env*

# Ficheros temporales de Office (~$libro.xlsx) mientras el documento está abierto
~$*

# Salida local de Jekyll si se prueba el build
/_site/

# ===== Utilidades locales que no son del sitio =====
*.py
*.ps1
*.vbs
*.bat

# ===== Datos =====
# Por defecto los CSV son intermedios de trabajo. Los que la web carga en
# runtime u ofrece en descarga se versionan explícitamente.
*.csv
!data/flujos_data.csv
!data/correspondencias-sectores-nc8.csv
!data/estadisticas.csv
!balanza/*.csv
balanza_preview.txt

# ===== Material de trabajo (solo en la máquina local) =====
# review/: auditoría del temario y borradores de LinkedIn (se regeneran).
# docs/: planes y notas de diseño.
# fuentes/: temas del opositor para el agente del ejercicio 1; no es contenido del sitio.
review/
docs/
fuentes/

# ===== Agentes / IDE =====
# De .claude/ solo se versiona el agente del ejercicio 1, para que una sesión
# en la nube lo tenga. Jekyll no publica carpetas que empiezan por punto.
.claude/*
!.claude/agents/
.agent/
.gemini/
